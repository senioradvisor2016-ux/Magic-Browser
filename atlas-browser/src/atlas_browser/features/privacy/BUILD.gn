# =============================================================================
# Privacy Feature
# =============================================================================

component("privacy") {
  output_name = "atlas_privacy"
  
  sources = [
    "tracker_blocker.cc",
    "tracker_blocker.h",
  ]
  
  deps = [
    "//base",
    "//url",
  ]
  
  defines = [ "ATLAS_PRIVACY_IMPLEMENTATION" ]
}

# =============================================================================
# Unit Tests
# =============================================================================

source_set("unit_tests") {
  testonly = true
  
  sources = [
    "tracker_blocker_unittest.cc",
  ]
  
  deps = [
    ":privacy",
    "//base/test:test_support",
    "//testing/gtest",
    "//url",
  ]
}
